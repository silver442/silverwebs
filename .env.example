# Número de WhatsApp en formato internacional sin "+" ni espacios (México: 52 + 10 dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# URL pública del sitio, sin "/" final
NEXT_PUBLIC_SITE_URL=https://silverwebs.dev

# Envío de correos con Resend (formulario de contacto y cotizador)
RESEND_API_KEY=
# Correo donde se reciben mensajes y cotizaciones
CONTACT_TO_EMAIL=
# Remitente verificado en Resend, p. ej. "SilverWebs <contacto@silverwebs.dev>"
CONTACT_FROM_EMAIL=

# (Opcional) Código de verificación de Google Search Console (meta tag "google-site-verification")
NEXT_PUBLIC_GSC_VERIFICATION=
