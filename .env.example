# Número de WhatsApp en formato internacional sin "+" ni espacios (México: 52 + 10 dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER=5210000000000
# Correo que recibe cotizaciones y mensajes de contacto
NEXT_PUBLIC_CONTACT_EMAIL=tu-correo@ejemplo.com
# URL pública del sitio, sin "/" final (en Vercel: https://tu-dominio.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

